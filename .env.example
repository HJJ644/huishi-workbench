# 复制为 .env.local 仅用于本地 vercel dev；Vercel 线上请在项目 Settings → Environment Variables 里填
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PRIVATE_KEY=                 # 推荐：EmailJS 的 Private Key（服务端专用）
EMAILJS_PUBLIC_KEY=                  # 无 Private Key 时填这个
VCODE_SECRET=                        # 可选：验证码签名密钥，多实例部署建议设一串随机字符
ALLOWED_ORIGINS=                     # 可选：额外允许的前端来源，如 https://xxx.vercel.app
